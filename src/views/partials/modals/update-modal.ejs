<!-- Update Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-gradient bg-primary text-white py-3">
        <h5 class="modal-title d-flex align-items-center gap-2" id="updateModalLabel" style="font-size:1.1rem; font-weight:600;">
          <i class="bi bi-github"></i> Cập Nhật Online (GitHub)
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4">
        <div id="updateLoadingState" class="text-center py-4">
          <div class="spinner-border text-primary mb-3" role="status" style="width: 2.5rem; height: 2.5rem;">
            <span class="visually-hidden">Đang kiểm tra...</span>
          </div>
          <p class="text-muted mb-0 fw-medium">Đang kiểm tra bản cập nhật mới từ GitHub...</p>
        </div>

        <div id="updateContentState" class="d-none">
          <div id="updateAlertContainer" class="mb-3"></div>

          <div class="card bg-light border-0 mb-3">
            <div class="card-body p-3" style="font-size: 0.85rem;">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary fw-semibold">Phiên bản hiện tại:</span>
                <span class="badge bg-secondary" id="currentVersionBadge">v13.3</span>
              </div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="text-secondary fw-semibold">Mã Commit mới nhất:</span>
                <span class="badge bg-dark" id="latestCommitBadge">---</span>
              </div>
              <div class="mb-2">
                <span class="text-secondary fw-semibold">Nội dung cập nhật:</span>
                <div id="commitMessageText" class="p-2 mt-1 bg-white rounded border text-wrap text-break" style="max-height: 100px; overflow-y: auto; font-family: monospace; font-size: 0.8rem;">
                  Checking...
                </div>
              </div>
              <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.75rem;">
                <span>Thời gian commit:</span>
                <span id="commitDateText">---</span>
              </div>
            </div>
          </div>

          <div id="updateProgressContainer" class="d-none mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1" style="font-size: 0.8rem;">
              <span id="updateProgressStatus" class="fw-semibold text-primary">Đang tải bản cập nhật...</span>
              <span id="updateProgressPercent" class="fw-bold text-primary">0%</span>
            </div>
            <div class="progress" style="height: 8px;">
              <div id="updateProgressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 0%"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer bg-light py-2">
        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnCheckUpdateAgain">
          <i class="bi bi-arrow-clockwise me-1"></i> Kiểm tra lại
        </button>
        <button type="button" class="btn btn-primary btn-sm px-3" id="btnApplyUpdate" disabled>
          <i class="bi bi-download me-1"></i> Cập Nhật Ngay
        </button>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>
