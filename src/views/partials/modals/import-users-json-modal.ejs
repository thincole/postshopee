<div class="modal fade" id="importJsonModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-filetype-json me-2"></i>Nhập Người Dùng Từ JSON</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="importJsonForm" enctype="multipart/form-data">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Chọn file JSON</label>
                        <input type="file" class="form-control" name="userJsonFile" accept=".json" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Quốc Gia (Mặc định)</label>
                        <select class="form-select" name="country">
                            <option value="vn" selected>🇻🇳 Việt Nam</option>
                            <option value="phss">🇵🇭 PH SlideShow</option>
                            <option value="ar">🇦🇷 Argentina</option>
                            <option value="sg">🇸🇬 Singapore</option>
                            <option value="id">🇮🇩 Indonesia</option>
                            <option value="th">🇹🇭 Thái Lan</option>
                            <option value="my">🇲🇾 Malaysia</option>
                            <option value="ph">🇵🇭 Philippines</option>
                            <option value="br">🇧🇷 Brazil</option>
                            <option value="mx">🇲🇽 México</option>
                            <option value="tw">🇹🇼 Đài Loan</option>
                        </select>
                        <div class="form-text">Các tài khoản không ghi "country" trong JSON sẽ nhận quốc gia này.</div>
                    </div>
                    <div class="alert alert-info small py-2">
                        <strong>Format:</strong>
                        <pre class="mb-0 mt-1" style="font-size:0.75rem">[
  { "username": "user1", "cookie": "cookie1..." },
  { "username": "user2", "cookie": "cookie2..." }
]</pre>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary btn-sm">Nhập</button>
                </div>
            </form>
        </div>
    </div>
</div>
