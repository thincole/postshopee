            </div>
            <div class="modal-body">
                <p class="small text-muted mb-3">Cập nhật thời gian Delay ngẫu nhiên giữa các lần đăng video cho các luồng đã chọn hoặc tất cả luồng.</p>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small fw-bold">Delay Tối Thằng (Giây)</label>
                        <input type="number" class="form-control form-control-sm" id="batchDelayMinInput" value="186" min="10">
                    </div>
                    <div class="col-6">
                        <label class="form-label small fw-bold">Delay Tối Đa (Giây)</label>
                        <input type="number" class="form-control form-control-sm" id="batchDelayMaxInput" value="245" min="10">
                    </div>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="batchDelayOnlySelectedCheck">
                    <label class="form-check-label small" for="batchDelayOnlySelectedCheck">
                        Chỉ áp dụng cho các luồng đang được tích chọn
                    </label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary btn-sm fw-bold" onclick="saveBatchDelay()">Lưu Cập Nhật</button>
            </div>
        </div>
    </div>
</div>

<script>
  function toggleQuickImportCollapseIcon(headerEl) {
    setTimeout(() => {
      const collapseEl = document.getElementById('quickImportCollapse');
      const icon = document.getElementById('quickImportCollapseIcon');
      const text = document.getElementById('quickImportCollapseText');
      if (!collapseEl) return;
      const isShown = collapseEl.classList.contains('show');
      if (isShown) {
        if (icon) icon.className = 'bi bi-chevron-up';
        if (text) text.textContent = 'Thu gọn';
        localStorage.setItem('quickImportCollapsed', 'false');
      } else {
        if (icon) icon.className = 'bi bi-chevron-down';
        if (text) text.textContent = 'Mở rộng';
        localStorage.setItem('quickImportCollapsed', 'true');
      }
    }, 200);
  }

  document.addEventListener('DOMContentLoaded', () => {
    const isCollapsed = localStorage.getItem('quickImportCollapsed') === 'true';
    if (isCollapsed) {
      const collapseEl = document.getElementById('quickImportCollapse');
      const icon = document.getElementById('quickImportCollapseIcon');
      const text = document.getElementById('quickImportCollapseText');
      if (collapseEl) collapseEl.classList.remove('show');
      if (icon) icon.className = 'bi bi-chevron-down';
      if (text) text.textContent = 'Mở rộng';
    }
  });
</script>