<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shopee Video Manager V13.3</title>

  <!-- Bootstrap CSS -->
  <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">

  <!-- Bootstrap Icons -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

  <!-- Custom CSS (inline since no static route for /css) -->
  <style>
    :root {
      --primary: #ee4d2d;
      --primary-dark: #d73211;
      --primary-light: #fff0ed;
      --sidebar-bg: #1a1a2e;
      --card-shadow: 0 2px 12px rgba(0,0,0,0.08);
      --border-radius: 10px;
    }

    body {
      background: #f0f2f5;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 0.875rem;
    }

    /* Card styling */
    .card {
      border: none;
      border-radius: var(--border-radius);
      box-shadow: var(--card-shadow);
    }
    .card-header {
      background: linear-gradient(135deg, #ee4d2d 0%, #c0392b 50%, #922b21 100%);
      color: #fff !important;
      border-radius: var(--border-radius) var(--border-radius) 0 0 !important;
      padding: 1rem 1.5rem;
      border-bottom: 3px solid rgba(0,0,0,0.1);
    }
    .header-logo {
      width: 48px;
      height: 48px;
      background: rgba(255,255,255,0.15);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }

    /* Nav pills */
    .nav-pills {
      background: #fff;
      border-radius: var(--border-radius);
      padding: 6px;
      box-shadow: var(--card-shadow);
    }
    .nav-pills .nav-link {
      color: #6c757d;
      border-radius: 8px;
      padding: 10px 18px;
      font-weight: 500;
      font-size: 0.85rem;
      transition: all 0.2s ease;
    }
    .nav-pills .nav-link.active {
      background: var(--primary);
      color: #fff;
      box-shadow: 0 2px 8px rgba(238, 77, 45, 0.3);
    }
    .nav-pills .nav-link:hover:not(.active) {
      background: var(--primary-light);
      color: var(--primary);
    }

    /* Tables */
    .table {
      font-size: 0.82rem;
      border-collapse: separate;
      border-spacing: 0;
    }
    .table thead th {
      background: #2d3748;
      color: #fff;
      font-weight: 600;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 10px 12px;
      white-space: nowrap;
      border: none;
      position: sticky;
      top: 0;
      z-index: 1;
    }
    .table thead th:first-child {
      border-radius: 8px 0 0 0;
    }
    .table thead th:last-child {
      border-radius: 0 8px 0 0;
    }
    .table tbody tr {
      transition: background 0.15s ease;
    }
    .table tbody tr:hover {
      background: var(--primary-light);
    }
    .table tbody td {
      padding: 8px 12px;
      vertical-align: middle;
      border-bottom: 1px solid #e9ecef;
    }
    .table-responsive {
      border-radius: var(--border-radius);
      overflow-x: auto;
    }

    /* Buttons */
    .btn {
      font-size: 0.82rem;
      font-weight: 500;
      border-radius: 6px;
      padding: 6px 14px;
      transition: all 0.2s ease;
    }
    .btn-primary {
      background: var(--primary);
      border-color: var(--primary);
    }
    .btn-primary:hover {
      background: var(--primary-dark);
      border-color: var(--primary-dark);
      transform: translateY(-1px);
      box-shadow: 0 3px 8px rgba(238, 77, 45, 0.3);
    }
    .btn-sm {
      font-size: 0.75rem;
      padding: 4px 10px;
    }

    /* Badges */
    .badge {
      font-size: 0.72rem;
      font-weight: 600;
      padding: 5px 10px;
      border-radius: 20px;
      letter-spacing: 0.3px;
    }

    /* Form controls */
    .form-control, .form-select {
      font-size: 0.82rem;
      border-radius: 6px;
      border: 1px solid #dee2e6;
      padding: 6px 12px;
    }
    .form-control:focus, .form-select:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(238, 77, 45, 0.15);
    }

    /* Pagination */
    .pagination {
      gap: 4px;
    }
    .pagination .page-link {
      border-radius: 6px;
      border: 1px solid #dee2e6;
      color: #495057;
      font-size: 0.8rem;
      padding: 6px 12px;
      min-width: 36px;
      text-align: center;
    }
    .pagination .page-item.active .page-link {
      background: var(--primary);
      border-color: var(--primary);
      color: #fff;
    }
    .pagination .page-link:hover {
      background: var(--primary-light);
      color: var(--primary);
      border-color: var(--primary);
    }

    /* Alerts */
    .alert {
      border-radius: 8px;
      font-size: 0.82rem;
      border: none;
    }
    .alert-info {
      background: #e7f3ff;
      color: #0c63e4;
    }

    /* Section titles */
    h2.mb-4 {
      font-size: 1.15rem;
      font-weight: 700;
      color: #2d3748;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--primary);
      display: inline-block;
    }

    /* Toast */
    .toast-container {
      z-index: 9999 !important;
    }

    /* Scrollbar */
    ::-webkit-scrollbar {
      height: 6px;
      width: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #f1f1f1;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb {
      background: #c1c1c1;
      border-radius: 3px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #a1a1a1;
    }

    /* Modal */
    .modal-header {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      color: #fff;
      border-radius: 0;
    }
    .modal-header .btn-close {
      filter: brightness(0) invert(1);
    }
    .modal-content {
      border: none;
      border-radius: var(--border-radius);
      overflow: hidden;
    }

    /* Log detail tooltip */
    .log-error-cell {
      max-width: 250px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      cursor: pointer;
    }
    .log-error-cell:hover {
      white-space: normal;
      word-break: break-all;
      background: #fff3cd;
    }

    /* Stats cards */
    .stats-card {
      background: #fff;
      border-radius: var(--border-radius);
      padding: 16px 20px;
      box-shadow: var(--card-shadow);
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .stats-card .icon {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
    }
    .stats-card .info h6 {
      font-size: 0.72rem;
      color: #6c757d;
      margin: 0;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .stats-card .info .value {
      font-size: 1.3rem;
      font-weight: 700;
      color: #2d3748;
    }

    /* Input group */
    .input-group-text {
      font-size: 0.82rem;
      border-radius: 6px 0 0 6px;
    }
  </style>
</head>
