            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">API Token (Bearer)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                        <input type="password" class="form-control" id="homeproxyTokenInput"
                            placeholder="homepx42152_e21c0b975d1093642c0a6e95bd760a49a4f7bf5a2e67ba971535c18940288b1e">
                        <button class="btn btn-outline-secondary" type="button"
