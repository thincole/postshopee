<h2 class="mb-4"><i class="bi bi-gear-fill me-2"></i>Cài Đặt</h2>

<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-2 d-flex justify-content-between align-items-center" style="background: #2d3748; border-radius: 0;">
                <h6 class="mb-0 text-white"><i class="bi bi-shield-check me-2"></i>Cấu hình Ký Số (Signing Service)</h6>
                <span class="badge bg-primary" id="currentSignBadge">Credit API</span>
            </div>
            <div class="card-body">
                <!-- Chọn chế độ ký -->
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Phương thức Ký</label>
                    <div class="d-flex gap-3 p-2 bg-light rounded border">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="signModeRadio" id="signModeCredit" value="credit" onchange="onSignModeChange()" checked>
                            <label class="form-check-label fw-semibold small" for="signModeCredit">
                                <i class="bi bi-cloud-check text-primary me-1"></i>Server Credit
                            </label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="signModeRadio" id="signModePhone" value="phone" onchange="onSignModeChange()">
                            <label class="form-check-label fw-semibold small" for="signModePhone">
                                <i class="bi bi-phone-fill text-success me-1"></i>Phone Sign (Nội bộ)
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Form Credit API -->
                <div id="creditApiFormGroup">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">URL API Credit</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                            <input type="text" class="form-control" id="creditUrlInput"
                                placeholder="https://creditmls2026video.toolshopee.vn/api/sign">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">API Key Credit</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                            <input type="text" class="form-control" id="creditKeyInput" placeholder="X-API-Key...">
                            <button class="btn btn-outline-secondary" type="button" onclick="toggleCreditKeyVisibility()"
                                title="Hiện/Ẩn">
                                <i class="bi bi-eye" id="creditKeyEyeIcon"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Form Phone Sign -->
                <div id="phoneSignFormGroup" style="display: none;">
                    <!-- Quản lý Thiết bị ADB tích hợp sẵn -->
                    <div class="p-3 mb-3 bg-light rounded border">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-semibold small mb-0"><i class="bi bi-usb-symbol text-primary me-1"></i>Chọn Điện Thoại Ký Số (ADB USB)</label>
                            <button class="btn btn-sm btn-link p-0 text-decoration-none" type="button" onclick="loadAdbDevices()" title="Quét lại thiết bị">
                                <i class="bi bi-arrow-clockwise me-1"></i>Quét lại
                            </button>
                        </div>
                        <div class="input-group input-group-sm mb-2">
                            <span class="input-group-text"><i class="bi bi-phone"></i></span>
                            <select class="form-select" id="adbDeviceSelect">
                                <option value="">-- Đang quét thiết bị kết nối USB... --</option>
                            </select>
                            <button class="btn btn-outline-primary" type="button" onclick="forwardAdbSelectedDevice()" id="adbForwardBtn">
                                <i class="bi bi-lightning-charge-fill me-1"></i>Forward Cổng 8080
                            </button>
                        </div>
                        <div id="adbForwardStatus" class="small text-muted"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">URL Phone Sign</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                            <input type="text" class="form-control" id="phoneSignUrlInput"
                                placeholder="http://127.0.0.1:8080">
                        </div>
                        <div class="form-text small text-muted">
                            Mặc định là <code>http://127.0.0.1:8080</code> (khi dùng ADB Forward) hoặc <code>http://192.168.1.xxx:8080</code> (qua Wi-Fi).
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Secret Key</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input type="text" class="form-control" id="phoneSignKeyInput" placeholder="secret_key" value="secret_key">
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary btn-sm" onclick="saveCreditSettings()">
                        <i class="bi bi-check-lg me-1"></i>Lưu cài đặt
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="loadCreditSettings()">
                        <i class="bi bi-arrow-clockwise me-1"></i>Tải lại
                    </button>
                    <button class="btn btn-outline-info btn-sm" onclick="checkCreditBalance()" id="creditBalanceBtn">
                        <i class="bi bi-wallet2 me-1"></i>Kiểm tra số dư
                    </button>
                    <button class="btn btn-outline-success btn-sm" onclick="checkPhoneSignConnection()" id="phoneSignCheckBtn" style="display: none;">
                        <i class="bi bi-activity me-1"></i>Kiểm tra kết nối Phone
                    </button>
                </div>
                <div id="creditBalanceResult" class="mt-2" style="display:none;"></div>
                <div id="phoneSignCheckResult" class="mt-2" style="display:none;"></div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm mb-4" style="border-left: 3px solid var(--primary);">
            <div class="card-body">
                <h6 class="text-muted mb-3"><i class="bi bi-info-circle me-2"></i>Hướng dẫn Cấu hình Ký Số</h6>
                <ul class="small mb-0" style="line-height: 1.8;">
                    <li><strong>Server Credit</strong>: Dùng dịch vụ ký API từ xa của MLS (tiêu tốn credit theo gói).</li>
                    <li><strong>Phone Sign</strong>: Dùng server ký nội bộ trên máy Note 8 LSPosed (hoàn toàn miễn phí, không giới hạn).</li>
                    <li><strong>ADB Forward</strong>: Chạy lệnh <code>adb forward tcp:8080 tcp:8080</code> để PC kết nối trực tiếp qua USB siêu nhanh.</li>
                </ul>
            </div>
        </div>
    </div>
</div>



<div class="row">
    <div class="col-lg-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header py-2" style="background: #37474f; border-radius: 0;">
                <h6 class="mb-0 text-white"><i class="bi bi-link-45deg me-2"></i>API URL Key 1</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">URL Domain</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-globe"></i></span>
                        <input type="text" class="form-control" id="apiUrlKey1Input" placeholder="https://domain.com">
                    </div>
                    <div class="form-text">Nhập domain API. Để trống sẽ dùng giá trị mặc định.</div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary btn-sm" onclick="saveApiUrlKey1()">
                        <i class="bi bi-check-lg me-1"></i>Lưu
                    </button>
                    <button class="btn btn-outline-secondary btn-sm" onclick="loadApiUrlKey1()">
