<script>
    function loadCreditSettings() {
        fetch('/api/config/credit')
            .then(res => res.json())
            .then(data => {
                document.getElementById('creditUrlInput').value = data.credit_url || '';
                document.getElementById('creditKeyInput').value = data.credit_key || '';
            })
            .catch(() => { });
    }

    function saveCreditSettings() {
        const credit_url = document.getElementById('creditUrlInput').value.trim();
        const credit_key = document.getElementById('creditKeyInput').value.trim();

        if (!credit_url || !credit_key) {
            showToast('URL và Key không được để trống', 'error');
            return;
        }

        fetch('/api/config/credit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ credit_url, credit_key })
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast('Lưu cài đặt credit thành công', 'success');
                } else {
                    showToast(data.message || 'Lỗi lưu cài đặt', 'error');
                }
            })
            .catch(() => showToast('Lỗi kết nối', 'error'));
    }

    function toggleCreditKeyVisibility() {
        const input = document.getElementById('creditKeyInput');
        const icon = document.getElementById('creditKeyEyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // === API URL Key 1 ===
    function loadApiUrlKey1() {
        fetch('/api/config/api-url-key1')
            .then(res => res.json())
            .then(data => {
                document.getElementById('apiUrlKey1Input').value = data.api_url_key1 || '';
            })
            .catch(() => { });
    }

    function saveApiUrlKey1() {
        const api_url_key1 = document.getElementById('apiUrlKey1Input').value.trim();
        fetch('/api/config/api-url-key1', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ api_url_key1 })
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast('Lưu API URL Key 1 thành công', 'success');
                } else {
                    showToast(data.message || 'Lỗi lưu', 'error');
                }
            })
            .catch(() => showToast('Lỗi kết nối', 'error'));
    }



    // === Credit Balance Check ===
    function checkCreditBalance() {
        const btn = document.getElementById('creditBalanceBtn');
        const result = document.getElementById('creditBalanceResult');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang kiểm tra...';
        result.style.display = 'none';

        fetch('/api/config/credit-balance')
            .then(res => res.json())
            .then(data => {
                result.style.display = '';
                if (data.success) {
                    const statusBadge = data.is_active
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-danger">Inactive</span>';
                    const creditClass = data.credits > 50 ? 'text-success' : data.credits > 10 ? 'text-warning' : 'text-danger';
                    result.innerHTML = `
                    <div class="alert alert-info py-2 mb-0 small">
                        <i class="bi bi-person me-1"></i><strong>${data.username}</strong> ${statusBadge}
                        <span class="ms-3"><i class="bi bi-wallet2 me-1"></i>Số dư: <strong class="${creditClass}">${data.credits} credits</strong></span>
                    </div>`;
                } else {
                    result.innerHTML = `<div class="alert alert-danger py-2 mb-0 small">${data.error}</div>`;
                }
            })
            .catch(() => {
                result.style.display = '';
                result.innerHTML = '<div class="alert alert-danger py-2 mb-0 small">Lỗi kết nối</div>';
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-wallet2 me-1"></i>Kiểm tra số dư';
            });
    }

    // === Proxy Checker ===
    function checkProxies() {
        const input = document.getElementById('proxyCheckInput');
        const btn = document.getElementById('checkProxyBtn');
        const summary = document.getElementById('proxyCheckSummary');
        const resultsDiv = document.getElementById('proxyCheckResults');
        const tbody = document.getElementById('proxyCheckTable');

        const lines = input.value.split('\n').map(l => l.trim()).filter(l => l.length > 0);
        if (lines.length === 0) {
            showToast('Nhập ít nhất 1 proxy', 'warning');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang check...';
        summary.textContent = `Đang check ${lines.length} proxy...`;
        resultsDiv.style.display = 'none';

        fetch('/api/config/check-proxy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ proxies: lines })
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    showToast(data.error || 'Lỗi check proxy', 'error');
                    return;
                }

                const s = data.summary;
                summary.innerHTML = `<span class="badge bg-success">${s.alive} sống</span> <span class="badge bg-danger">${s.dead} chết</span> / ${s.total} proxy`;

                resultsDiv.style.display = '';
                tbody.innerHTML = data.results.map((r, i) => {
                    const statusBadge = r.alive
                        ? `<span class="badge bg-success">Sống</span>`
                        : `<span class="badge bg-danger">${r.error}</span>`;
                    const pingText = r.alive ? `${r.ms}ms` : '-';
                    const pingClass = r.alive ? (r.ms < 2000 ? 'text-success' : r.ms < 5000 ? 'text-warning' : 'text-danger') : 'text-muted';
                    return `<tr class="${r.alive ? '' : 'table-danger'}">
                <td class="small text-muted">${i + 1}</td>
                <td class="small"><code>${r.proxy}</code></td>
                <td class="small ${pingClass}">${pingText}</td>
                <td>${statusBadge}</td>
            </tr>`;
                }).join('');
            })
            .catch(() => showToast('Lỗi kết nối', 'error'))
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-lightning-charge me-1"></i>Check Proxy';
            });
    }

    function importProxiesDirectly() {
        const input = document.getElementById('proxyCheckInput');
        const btn = document.getElementById('importProxyBtn');
        const summary = document.getElementById('proxyCheckSummary');
        const resultsDiv = document.getElementById('proxyCheckResults');

        const lines = input.value.split('\n').map(l => l.trim()).filter(l => l.length > 0);
        if (lines.length === 0) {
            showToast('Nhập ít nhất 1 proxy', 'warning');
            return;
        }

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang import...';

        fetch('/api/config/import-proxy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ proxies: lines })
        })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    showToast(data.error || 'Lỗi import proxy', 'error');
                    return;
                }
                showToast(data.message, 'success');
                summary.innerHTML = `<span class="badge bg-success">${lines.length} sống</span> / ${lines.length} proxy`;
                resultsDiv.style.display = 'none';
            })
            .catch(() => showToast('Lỗi kết nối', 'error'))
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-download me-1"></i>Import Proxy';
            });
    }

    function clearAllProxies() {
        if (!confirm('Bạn có chắc chắn muốn xóa toàn bộ proxy trong database?')) {
            return;
        }
        const btn = document.getElementById('clearProxyBtn');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xóa...';

        fetch('/api/config/clear-proxies', {
            method: 'DELETE'
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast(data.message, 'success');
                    document.getElementById('proxyCheckInput').value = '';
                    document.getElementById('proxyCheckSummary').innerHTML = '';
                    const resultsDiv = document.getElementById('proxyCheckResults');
                    if (resultsDiv) resultsDiv.style.display = 'none';
                } else {
                    showToast(data.error || 'Lỗi khi xóa proxy', 'error');
                }
            })
            .catch(() => showToast('Lỗi kết nối', 'error'))
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-trash me-1"></i>Xóa Proxy';
            });
    }

    function loadSavedProxies() {
        fetch('/api/config/saved-proxies')
            .then(res => res.json())
            .then(data => {
                if (data.success && data.proxies) {
                    document.getElementById('proxyCheckInput').value = data.proxies.join('\n');
                }
            })
            .catch(() => { });
    }

    function loadHomeProxyToken() {
        fetch('/api/config/homeproxy-token')
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('homeproxyTokenInput').value = data.homeproxy_token || '';
                    if (document.getElementById('homeproxyMerchantIdInput')) {
                        document.getElementById('homeproxyMerchantIdInput').value = data.homeproxy_merchant_id || '';
                    }
                }
            })
            .catch(() => { });
    }

    function saveHomeProxyToken() {
        const token = document.getElementById('homeproxyTokenInput').value.trim();
        const merchantId = document.getElementById('homeproxyMerchantIdInput') ? document.getElementById('homeproxyMerchantIdInput').value.trim() : '';
        fetch('/api/config/homeproxy-token', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ homeproxy_token: token, homeproxy_merchant_id: merchantId })
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast('Lưu HomeProxy API Token & Merchant ID thành công', 'success');
                } else {
                    showToast(data.error || 'Lỗi lưu token', 'error');
                }
            })
            .catch(() => showToast('Lỗi kết nối', 'error'));
    }

    function syncHomeProxyProxies() {
        const btn = document.getElementById('syncHomeProxyBtn');
        const result = document.getElementById('homeproxySyncResult');

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang đồng bộ...';
        result.style.display = 'none';

        fetch('/api/config/sync-homeproxy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        })
            .then(res => res.json())
            .then(data => {
                result.style.display = '';
                if (data.success) {
                    result.innerHTML = `<div class="alert alert-success py-1 px-2 mb-0 small">${data.message}</div>`;
                    showToast('Đồng bộ proxy thành công', 'success');
                    loadSavedProxies();
                } else {
                    result.innerHTML = `<div class="alert alert-danger py-1 px-2 mb-0 small">${data.error}</div>`;
                    showToast(data.error || 'Lỗi đồng bộ', 'error');
                }
            })
            .catch(() => {
                result.style.display = '';
                result.innerHTML = '<div class="alert alert-danger py-1 px-2 mb-0 small">Lỗi kết nối</div>';
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Đồng bộ Proxy';
            });
    }

    function toggleHomeProxyTokenVisibility() {
        const input = document.getElementById('homeproxyTokenInput');
        const icon = document.getElementById('homeproxyTokenEyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    function loadTelegramSettings() {
        fetch('/api/config/telegram')
            .then(res => res.json())
            .then(data => {
                if (data.success && data.settings) {
                    document.getElementById('telegramTokenInput').value = data.settings.telegram_token || '';
                    document.getElementById('telegramChatIdInput').value = data.settings.telegram_chat_id || '';
                    document.getElementById('telegramReportSuccessInput').checked = !!data.settings.telegram_report_success;
                    document.getElementById('telegramReportHourlyInput').checked = !!data.settings.telegram_report_hourly;
                }
            })
            .catch(() => { });
    }

    function saveTelegramSettings() {
        const token = document.getElementById('telegramTokenInput').value.trim();
        const chatId = document.getElementById('telegramChatIdInput').value.trim();
        const reportSuccess = document.getElementById('telegramReportSuccessInput').checked ? 1 : 0;
        const reportHourly = document.getElementById('telegramReportHourlyInput').checked ? 1 : 0;

        fetch('/api/config/telegram', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                telegram_token: token,
                telegram_chat_id: chatId,
                telegram_report_success: reportSuccess,
                telegram_report_hourly: reportHourly
            })
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    showToast('Lưu cấu hình Telegram thành công', 'success');
                } else {
                    showToast(data.error || 'Lỗi lưu cấu hình', 'error');
                }
            })
            .catch(() => showToast('Lỗi kết nối', 'error'));
    }

    function testTelegramConnection() {
        const token = document.getElementById('telegramTokenInput').value.trim();
        const chatId = document.getElementById('telegramChatIdInput').value.trim();
        if (!token || !chatId) {
            showToast('Vui lòng điền đủ Bot Token và Chat ID trước khi test', 'warning');
            return;
        }

        const btn = document.getElementById('testTelegramBtn');
        const result = document.getElementById('telegramTestResult');

        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang test...';
        result.style.display = 'none';

        fetch('/api/config/test-telegram', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ telegram_token: token, telegram_chat_id: chatId })
        })
            .then(res => res.json())
            .then(data => {
                result.style.display = '';
                if (data.success) {
                    result.innerHTML = `<div class="alert alert-success py-1 px-2 mb-0 small">${data.message}</div>`;
                    showToast('Gửi tin nhắn test thành công', 'success');
                } else {
                    result.innerHTML = `<div class="alert alert-danger py-1 px-2 mb-0 small">${data.error}</div>`;
                    showToast(data.error || 'Lỗi gửi tin nhắn test', 'error');
                }
            })
            .catch(() => {
                result.style.display = '';
                result.innerHTML = '<div class="alert alert-danger py-1 px-2 mb-0 small">Lỗi kết nối hoặc API Token sai</div>';
            })
            .finally(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-send me-1"></i>Gửi Tin Nhắn Test';
            });
    }

    function toggleTelegramTokenVisibility() {
        const input = document.getElementById('telegramTokenInput');
        const icon = document.getElementById('telegramTokenEyeIcon');
        if (input.type === 'password') {
            input.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            input.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }

    // Load on tab shown
    document.getElementById('settings-tab')?.addEventListener('shown.bs.tab', () => {
        loadCreditSettings();
        loadSavedProxies();
        loadApiUrlKey1();
        loadHomeProxyToken();
        loadTelegramSettings();
    });
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            loadCreditSettings();
            loadSavedProxies();
            loadApiUrlKey1();
            loadHomeProxyToken();
            loadTelegramSettings();
        }, 500);
    });
</script>